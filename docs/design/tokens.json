{
  "$description": "360shooter design tokens. Logical pixels of the 640x360 arena. Coders use only semantic (menu.*, hud.*, game.*) and component tokens, never raw palettes.",
  "color": {
    "ink": { "950": { "$value": "#0b0610" } },
    "plum": {
      "950": { "$value": "#120a19" },
      "900": { "$value": "#1a0f24" },
      "800": { "$value": "#20122c" },
      "750": { "$value": "#24142f" },
      "700": { "$value": "#2d1a3d" },
      "600": { "$value": "#3d2252" },
      "550": { "$value": "#55306e" },
      "500": { "$value": "#4a2c60" },
      "400": { "$value": "#8a6a9a" }
    },
    "coral": {
      "300": { "$value": "#ffa0ae" },
      "400": { "$value": "#ff6b8a" },
      "500": { "$value": "#de4c6e" },
      "600": { "$value": "#bf3458" }
    },
    "mint": {
      "200": { "$value": "#b8ffe9" },
      "400": { "$value": "#5fe0c0" },
      "600": { "$value": "#2fb393" }
    },
    "cream": {
      "50": { "$value": "#fff4e8" },
      "200": { "$value": "#e0c9d6" },
      "300": { "$value": "#d8c3d6" }
    },
    "gold": {
      "200": { "$value": "#ffe2a0" },
      "400": { "$value": "#ffcf4a" },
      "600": { "$value": "#c7922a" }
    },
    "red": {
      "300": { "$value": "#ff8a7b" },
      "800": { "$value": "#3a1726" },
      "700": { "$value": "#5a2236" }
    },
    "phos": {
      "50": { "$value": "#e5f2d8" },
      "200": { "$value": "#cae3af" },
      "300": { "$value": "#a8d86b" },
      "350": { "$value": "#a9c48a" },
      "600": { "$value": "#567f02" },
      "800": { "$value": "#2c4210" },
      "950": { "$value": "#0a1108" }
    },
    "biome": {
      "forest": { "$value": "#6cc04a" },
      "night": { "$value": "#6a86ff" },
      "elf": { "$value": "#c89bff" },
      "forest-ground": { "$value": "#2f5d34" },
      "night-ground": { "$value": "#0f1c3a" },
      "elf-ground": { "$value": "#3b2a6b" },
      "forest-ground-hi": { "$value": "#3a6e3f" },
      "forest-ground-lo": { "$value": "#26502b" },
      "night-ground-hi": { "$value": "#1c2d58" },
      "night-ground-lo": { "$value": "#0a142c" },
      "elf-ground-hi": { "$value": "#4a3880" },
      "elf-ground-lo": { "$value": "#30215a" },
      "desert": { "$value": "#f0c060", "$description": "Wueste: sticker swatch" },
      "pyramid": { "$value": "#e8784a", "$description": "Pyramiden: sticker swatch" },
      "oasis": { "$value": "#4ad8b8", "$description": "Pyramiden-Oase: sticker swatch" },
      "desert-ground": { "$value": "#755428" },
      "pyramid-ground": { "$value": "#5e3424" },
      "oasis-ground": { "$value": "#1c4a3c" },
      "desert-ground-hi": { "$value": "#84603a" },
      "desert-ground-lo": { "$value": "#664824" },
      "pyramid-ground-hi": { "$value": "#6c3e2c" },
      "pyramid-ground-lo": { "$value": "#4e2a1c" },
      "oasis-ground-hi": { "$value": "#245a48" },
      "oasis-ground-lo": { "$value": "#123a2e" }
    },

    "sprite": {
      "$description": "Fixed palette of the astronaut and the raygun, identical in every biome.",
      "outline": { "$value": "{color.ink.950}" },
      "suit": { "$value": "{color.cream.50}" },
      "suit-shade": { "$value": "{color.cream.200}" },
      "visor": { "$value": "#2a1640" },
      "visor-glint": { "$value": "{color.coral.300}" },
      "eyes": { "$value": "{color.mint.400}" },
      "cheeks": { "$value": "{color.coral.300}" },
      "accent": { "$value": "{color.coral.400}" },
      "raygun-glow": { "$value": "#ff8fae" },
      "highlight": { "$value": "#ffffff", "$description": "helmet and eye shine, laser head" },
      "suit-deep": { "$value": "#ac90b0", "$description": "deepest suit shadow (helmet neck, belt)" },
      "accent-shade": { "$value": "{color.coral.600}" },
      "eyes-hi": { "$value": "{color.mint.200}" },
      "eyes-shade": { "$value": "{color.mint.600}" },
      "muzzle-flash": { "$value": "#fff3b0", "$description": "raygun shot frame" },
      "coin": { "$value": "{color.gold.400}" },
      "coin-hi": { "$value": "{color.gold.200}" },
      "coin-lo": { "$value": "{color.gold.600}" }
    },

    "menu": {
      "bg": { "$value": "{color.plum.900}" },
      "surface": { "$value": "{color.plum.700}" },
      "surface-hi": { "$value": "{color.plum.500}" },
      "surface-lo": { "$value": "{color.plum.800}" },
      "surface-sunken": { "$value": "{color.plum.600}" },
      "surface-sunken-hi": { "$value": "{color.plum.550}" },
      "outline": { "$value": "{color.ink.950}" },
      "text": { "$value": "{color.cream.50}" },
      "text-muted": { "$value": "{color.cream.300}" },
      "text-disabled": { "$value": "{color.plum.400}" },
      "action-bg": { "$value": "{color.coral.400}" },
      "action-hi": { "$value": "{color.coral.300}" },
      "action-lo": { "$value": "{color.coral.600}" },
      "action-fg": { "$value": "{color.ink.950}" },
      "done-bg": { "$value": "{color.mint.400}" },
      "done-hi": { "$value": "{color.mint.200}" },
      "done-lo": { "$value": "{color.mint.600}" },
      "done-fg": { "$value": "{color.ink.950}" },
      "locked-bg": { "$value": "{color.plum.750}" },
      "locked-fg": { "$value": "{color.plum.400}" },
      "sticker-bg": { "$value": "{color.cream.50}" },
      "sticker-fg": { "$value": "{color.ink.950}" },
      "danger-bg": { "$value": "{color.red.800}" },
      "danger-hi": { "$value": "{color.red.700}" },
      "danger-fg": { "$value": "{color.red.300}" },
      "gold": { "$value": "{color.gold.400}" },
      "focus": { "$value": "{color.cream.50}" },
      "scrim": { "$value": "#0b0610cc" }
    },

    "hud": {
      "glass": { "$value": "#060c05b8" },
      "screen": { "$value": "{color.phos.950}" },
      "line": { "$value": "{color.phos.600}" },
      "line-dim": { "$value": "{color.phos.800}" },
      "text": { "$value": "{color.phos.50}" },
      "text-muted": { "$value": "{color.phos.350}" },
      "accent": { "$value": "{color.phos.300}" },
      "energy": { "$value": "{color.phos.300}" },
      "energy-low": { "$value": "{color.red.300}" },
      "gold": { "$value": "{color.gold.400}" },
      "danger": { "$value": "{color.red.300}" },
      "glow": { "$value": "#a8d86b73" },
      "scrim": { "$value": "#0a1108d9" },
      "focus": { "$value": "{color.phos.50}" },
      "flash": { "$value": "#a8d86b80", "$description": "H-14: power slot lights up once on store (200 ms), accent at 50 %" },
      "trail": { "$value": "{color.cream.200}", "$description": "H-14: boss bar, lost HP piece after a hit (300 ms)" },
      "danger-dim": { "$value": "{color.red.700}", "$description": "H-14: boss bar fill while invulnerable, always with tag IMMUN and dotted frame" }
    },

    "game": {
      "laser-raygun": { "$value": "{color.sprite.raygun-glow}" },
      "shield-ring": { "$value": "#5fb8ff" },
      "fire-ring": { "$value": "#ff8a3a" },
      "hit-flash": { "$value": "{color.cream.50}" },
      "firefly": { "$value": "#f3f07a" },
      "spore": { "$value": "#9ff5ec" },
      "sand": { "$value": "#f0c878", "$description": "Wueste: drifting sand grains, 3x1 streaks" },
      "ember": { "$value": "#ffb04a", "$description": "Pyramiden: rising embers from the braziers" },
      "oasis-mote": { "$value": "#d8ff8a", "$description": "Pyramiden-Oase: glow moths" },
      "ward": { "$value": "#7ad8ff", "$description": "Guardian dog ward magic: fill at opacity.aura plus a dotted 1 px ring (shape, not only colour)" },
      "aura": { "$value": "{color.mint.400}", "$description": "H-23: forest spirit aura. Fill at opacity.aura plus a 1 px ring at full opacity (shape, not only colour). Replaces 0x9b59b6 (2.6:1 on elf ground)" }
    }
  },

  "font": {
    "family": {
      "menu": { "$value": ["Astro Kapsel"], "$description": "Own bitmap font (docs/design/assets/fonts.js -> PNG + XML for Phaser BitmapText). 7 px cap height." },
      "hud": { "$value": ["Astro Funk"], "$description": "Own bitmap font, condensed, 8 px tall." }
    },
    "scale": {
      "1": { "$value": 1, "$description": "labels, hints (Funk 8 px, Kapsel 7 px)" },
      "2": { "$value": 2, "$description": "buttons, values, biome names" },
      "3": { "$value": 3, "$description": "HUD timer and energy, gold in panels" },
      "4": { "$value": 4, "$description": "logo, player level" }
    },
    "tracking": { "$value": 1, "$description": "1 font px between glyphs, times scale" },
    "lineGap": { "$value": 3, "$description": "font px between lines, times scale" }
  },

  "space": {
    "half": { "$value": "2px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" }
  },

  "border": {
    "menu": { "$value": "2px" },
    "hud": { "$value": "1px" },
    "focus": { "$value": "2px" }
  },

  "shadow": {
    "menu-drop": { "$value": "4px 4px 0 #0b0610", "$description": "hard pixel shadow, offset 4/4, no blur" },
    "menu-drop-small": { "$value": "2px 2px 0 #0b0610" },
    "menu-bevel": { "$value": "inset 2px 2px 0 var(--hi), inset -2px -2px 0 var(--lo)", "$description": "light edge top-left, dark edge bottom-right" }
  },

  "size": {
    "target": { "$value": "32px", "$description": "min touch target (WCAG 2.5.8 needs 24)" },
    "tile": { "$value": "32px" },
    "button-h": { "$value": "32px" },
    "hud-chip-h": { "$value": "24px" },
    "stick": { "$value": "88px" },
    "stick-knob": { "$value": "28px" },
    "energy-segments": { "$value": 10 },
    "hud-slot": { "$value": "40px", "$description": "H-14/H-23: power slot button, fixed 40 at every k (PE-94); margin to the arena edge = round(space.2 * k) like all HUD panels" },
    "hud-slot-gap": { "$value": "8px" },
    "hud-slot-icon-scale": { "$value": 3, "$description": "H-14: upper limit of the icon scale; with the 16x16 item sprites slotIconScale gives 2 (4 px inset)" }
  },

  "motion": {
    "duration": {
      "fast": { "$value": "80ms", "$description": "button press" },
      "base": { "$value": "150ms", "$description": "hover, panel open" },
      "slow": { "$value": "300ms", "$description": "result reveal" },
      "blink": { "$value": "500ms", "$description": "low energy, timer < 10 s, boss banner" },
      "hit": { "$value": "120ms", "$description": "white hit flash (enemies, boss bar fill)" },
      "store-flash": { "$value": "200ms", "$description": "H-14: power slot lights up once when a power is stored" },
      "trail": { "$value": "300ms", "$description": "H-14: lost-HP piece of the boss bar fades" }
    },
    "banner-blinks": { "$value": 3, "$description": "H-14: BOSS KOMMT! blinks 3 times (duration.blink), then stays; no blinking with prefers-reduced-motion" },
    "easing": {
      "pixel": { "$value": "steps(3)", "$description": "Phaser: 'Stepped' ease with 3 steps" },
      "out": { "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)", "$description": "Phaser: 'Cubic.easeOut'" }
    }
  },

  "opacity": {
    "dim": { "$value": 0.35, "$description": "H-14: icon of a blocked power slot" },
    "ghost": { "$value": 0.6, "$description": "H-14: silhouette icon of an empty power slot" },
    "hover": { "$value": 0.18, "$description": "Q-45: power slot hover fill (hud.accent over the glass)" },
    "blink": { "$value": 0.55, "$description": "Q-45: alpha at the low point of a blink (energy, timer, boss banner)" },
    "aura": { "$value": 0.25, "$description": "H-23: fill of the forest spirit aura (game.aura)" }
  },

  "$pairs": [
    { "fg": "color.menu.text", "bg": "color.menu.bg", "use": "text" },
    { "fg": "color.menu.text", "bg": "color.menu.surface", "use": "text" },
    { "fg": "color.menu.text-muted", "bg": "color.menu.surface", "use": "text" },
    { "fg": "color.menu.text-muted", "bg": "color.menu.bg", "use": "text" },
    { "fg": "color.menu.gold", "bg": "color.menu.surface", "use": "text" },
    { "fg": "color.menu.action-fg", "bg": "color.menu.action-bg", "use": "text" },
    { "fg": "color.menu.done-fg", "bg": "color.menu.done-bg", "use": "text" },
    { "fg": "color.menu.sticker-fg", "bg": "color.menu.sticker-bg", "use": "text" },
    { "fg": "color.menu.danger-fg", "bg": "color.menu.danger-bg", "use": "text" },
    { "fg": "color.menu.danger-fg", "bg": "color.menu.surface", "use": "text" },
    { "fg": "color.menu.locked-fg", "bg": "color.menu.locked-bg", "use": "ui" },
    { "fg": "color.menu.focus", "bg": "color.menu.bg", "use": "ui" },
    { "fg": "color.menu.focus", "bg": "color.menu.surface", "use": "ui" },
    { "fg": "color.menu.action-bg", "bg": "color.menu.surface", "use": "ui" },
    { "fg": "color.menu.done-bg", "bg": "color.menu.surface", "use": "ui" },
    { "fg": "color.hud.text", "bg": "color.hud.screen", "use": "text" },
    { "fg": "color.hud.text-muted", "bg": "color.hud.screen", "use": "text" },
    { "fg": "color.hud.accent", "bg": "color.hud.screen", "use": "text" },
    { "fg": "color.hud.gold", "bg": "color.hud.screen", "use": "text" },
    { "fg": "color.hud.danger", "bg": "color.hud.screen", "use": "text" },
    { "fg": "color.hud.line", "bg": "color.hud.screen", "use": "ui" },
    { "fg": "color.hud.energy", "bg": "color.hud.screen", "use": "ui" },
    { "fg": "color.hud.trail", "bg": "color.hud.screen", "use": "ui" },
    { "fg": "color.hud.accent", "bg": "color.biome.night-ground", "use": "ui" },
    { "fg": "color.hud.text", "bg": "color.biome.night-ground", "use": "text" },
    { "fg": "color.hud.text", "bg": "color.biome.forest-ground", "use": "text" },
    { "fg": "color.hud.text", "bg": "color.biome.elf-ground", "use": "text" },
    { "fg": "color.game.laser-raygun", "bg": "color.biome.night-ground", "use": "ui" },
    { "fg": "color.game.laser-raygun", "bg": "color.biome.forest-ground", "use": "ui" },
    { "fg": "color.game.laser-raygun", "bg": "color.biome.elf-ground", "use": "ui" },
    { "fg": "color.game.aura", "bg": "color.biome.forest-ground", "use": "ui" },
    { "fg": "color.game.aura", "bg": "color.biome.night-ground", "use": "ui" },
    { "fg": "color.game.aura", "bg": "color.biome.elf-ground", "use": "ui" },
    { "fg": "color.hud.text", "bg": "color.biome.desert-ground", "use": "text" },
    { "fg": "color.hud.text", "bg": "color.biome.pyramid-ground", "use": "text" },
    { "fg": "color.hud.text", "bg": "color.biome.oasis-ground", "use": "text" },
    { "fg": "color.game.laser-raygun", "bg": "color.biome.desert-ground", "use": "ui" },
    { "fg": "color.game.laser-raygun", "bg": "color.biome.pyramid-ground", "use": "ui" },
    { "fg": "color.game.laser-raygun", "bg": "color.biome.oasis-ground", "use": "ui" },
    { "fg": "color.game.aura", "bg": "color.biome.desert-ground", "use": "ui" },
    { "fg": "color.game.aura", "bg": "color.biome.pyramid-ground", "use": "ui" },
    { "fg": "color.game.aura", "bg": "color.biome.oasis-ground", "use": "ui" },
    { "fg": "color.game.ward", "bg": "color.biome.pyramid-ground", "use": "ui" }
  ]
}
